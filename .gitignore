# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.ty_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Generated output. Not committed AND not analysed: every directory in this section is also in
# ruff's `extend-exclude`, mypy's `exclude` and bandit's `exclude_dirs` in pyproject.toml. Add to
# one list and you must add to the other — gitignored is not excluded, and drift between these two
# lists lets a generated tree reach mypy, where duplicate modules stop the type-check dead.
# Local scratch: mining clones, survey output, built datasets, job results
work/

# Eval run artifacts + reports (generated by `mise run eval`; the harness/judge/report code is
# committed, its per-run output is not)
eval/runs/
eval/reports/

# Harbor's own per-job output tree, written under the working directory by `harbor run` (so by
# `mise run eval` and `mise run smoke-datapoint`). Holds trial logs, results, and the agent's
# session state — including its credentials and installed-plugin trees. Never committed.
jobs/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Terraform
infrastructure/terraform/.terraform/
infrastructure/terraform/.terraform.lock.hcl
infrastructure/terraform/terraform.tfstate
infrastructure/terraform/terraform.tfstate.backup
infrastructure/terraform/*.tfvars
infrastructure/terraform/*.tfvars.json
!infrastructure/terraform/*.tfvars.example

# Packaged archive (mise run package)
eval-harvest.zip
