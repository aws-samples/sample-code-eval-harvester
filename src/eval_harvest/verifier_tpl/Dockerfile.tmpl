# Sealed agent environment (FR-30). Generated by eval-harvest emit; do not edit by hand.
#
# The container is sealed against the repository's future: the agent sees the code at the base
# state with the change under review applied as uncommitted working-tree edits, and nothing that
# would let it reach the fix, the review discussion, or any later commit. Every sealing step below
# is load-bearing — a build produces a tree the seal checks (Seal.check_repo) pass on.
#
# Three container checks are skipped here, each because Harbor owns the thing the check asks for.
# Harbor appends a harness stanza to whatever this file ends with — `USER root`, `ENTRYPOINT []`,
# `CMD ["/agentd"]` (lambda_microvms.py:141-150, harness_dockerfile) — so the end of this file is
# not the end of the image:
# checkov:skip=CKV_DOCKER_3:A USER here is overridden — Harbor appends `USER root` after it, on purpose ("restores the daemon's privileges when a task Dockerfile ends on a non-root user; per-exec demotion is the daemon's job"). Adding one would claim a posture the built image does not have.
# checkov:skip=CKV_DOCKER_2:Nothing in this image serves a health-checkable endpoint. The image is built, then Harbor replaces the entrypoint with its agent daemon, whose liveness Harbor tracks itself.
# checkov:skip=CKV_DOCKER_7:`@BASE_IMAGE@` is a placeholder, not a ref — no tag can be written here. The emitter substitutes a pinned, non-latest ECR Public tag (`_AGENT_BASE_IMAGE = "public.ecr.aws/docker/library/buildpack-deps:bookworm-scm"`, emit.py:80).
FROM @BASE_IMAGE@

WORKDIR /work

# A shallow, single-branch, no-tags clone: only the base commit's tree, none of the history around
# it, and no tag pointing at a later state.
RUN git clone --depth 1 --single-branch --no-tags "@REPO_URL@" repo
WORKDIR /work/repo

# Fetch exactly the base commit and reset the working tree to it — the state *before* this change.
RUN git fetch --depth 1 origin @BASE_COMMIT@ \
 && git reset --hard @BASE_COMMIT@

# Seal the repository: remove the remote (no network channel back to the forge), delete every
# remote-tracking ref, expire the reflog (a superseded state is retrievable through it otherwise),
# and prune everything now unreachable — so a single reachable commit remains.
RUN git remote remove origin \
 && git for-each-ref --format='%(refname)' refs/remotes | xargs -r -n1 git update-ref -d \
 && git reflog expire --expire=now --all \
 && git gc --prune=now --aggressive

# Apply the change under review as uncommitted working-tree edits: the agent reviews the diff, and
# the diff is never committed, so the sealed history still names only the base commit.
COPY change.patch /work/change.patch
RUN git apply --whitespace=nowarn /work/change.patch \
 && rm -f /work/change.patch
